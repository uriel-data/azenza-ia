# Copiar a .env para desarrollo local. En Netlify van en Site configuration → Environment variables.
# .env nunca se commitea.

# Postgres (Neon). En local se puede dejar vacía: se usa una base PGlite en .dev-db/.
# Para probar contra Neon, usar la rama de desarrollo, nunca la de producción.
DATABASE_URL=

# Consultor IA (Gemini, plan gratuito). Sin key, el Consultor responde que está apagado.
GEMINI_API_KEY=
# Modelo Flash del plan gratuito; ver en AI Studio cuál tiene más consultas por día.
GEMINI_MODEL=gemini-3.5-flash
# "false" apaga el Consultor sin deploy (todo lo demás sigue andando).
CONSULTOR_ACTIVO=true
# Consultas por usuario y por día (día de Argentina).
CONSULTOR_LIMITE_USUARIO=3
# Consultas por día entre todos los usuarios: por debajo del límite diario del plan gratuito.
CONSULTOR_TOPE_GLOBAL=200
